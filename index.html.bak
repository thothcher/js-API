        <div class="bg-panel p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">[ ]</p><p class="mt-1 text-sm">მასივი — სია, რომელზეც <code class="font-mono text-[12px]">map</code> გადის</p></div>
        <div class="bg-panel p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">" "</p><p class="mt-1 text-sm">JSON-ში key <b>ყოველთვის</b> ბრჭყალებშია</p></div>
      </div>
    </div>
  </div>
</section>

<!-- 11 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="fetch" data-notes="გაიარე კლავიატურით, ნაბიჯ-ნაბიჯ. ყოველ ნაბიჯზე ჯერ ჰკითხე დარბაზს: რა აკლია ამ კოდს? მე-4 ნაბიჯზე (response.ok) ჩვეულებრივ ვერავინ ხვდება — და სწორედ ეს არის შემდეგი სლაიდის თემა. ეს არის ჩვენივე getProducts, ხაზ-ხაზ აწყობილი.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12" data-cbuild>
    <div class="col-span-5 flex flex-col">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ავაწყოთ</p>
      <h2 class="display mt-3 text-5xl leading-[1] font-semibold">ერთი fetch,<br>შვიდ ნაბიჯად</h2>

      <div class="mt-8 flex items-center gap-3">
        <button data-cbuild-prev class="border border-rule bg-panel px-4 py-2 font-mono text-[13px] hover:bg-ink hover:text-paper">← უკან</button>
        <button data-cbuild-next class="border border-ink bg-ink px-4 py-2 font-mono text-[13px] text-paper hover:bg-ink-2">შემდეგი →</button>
        <span data-cbuild-index class="font-mono text-[13px] text-ink-2"></span>
      </div>

      <div class="mt-6 min-h-[7rem] border-l-2 border-live pl-5">
        <p data-cbuild-note class="text-lg leading-snug"></p>
      </div>

      <div class="mt-auto border border-rule bg-panel p-5 text-sm text-ink-2">
        შვიდი ნაბიჯი, შვიდი გადაწყვეტილება. შენიშნეთ: სამი მათგანი საერთოდ არ ეხება
        მონაცემების მიღებას — ისინი პასუხობენ კითხვას „და თუ არ გამოვიდა?“.
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center">
      <div class="flex items-center gap-2 border-b border-[#2d2d2d] bg-[#252526] px-5 py-2.5">
        <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span></span>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-[#969696]">app.js</p>
      </div>
      <pre class="scroll min-h-[26rem] overflow-auto bg-[#1e1e1e] p-6 font-mono text-[13px] leading-[1.65] text-[#d4d4d4]"><code data-cbuild-code><span class="cl" data-line="0"><span class="text-[#569cd6]">async function</span> <span class="text-[#dcdcaa]">getProducts</span>() {</span>
<span class="cl" data-line="5">  <span class="text-[#c586c0]">try</span> {</span>
<span class="cl" data-line="1">    <span class="text-[#569cd6]">const</span> response = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(API_URL, {</span>
<span class="cl" data-line="2">      <span class="text-[#9cdcfe]">headers</span>: { <span class="text-[#ce9178]">'x-api-key'</span>: API_KEY }</span>
<span class="cl" data-line="1">    });</span>
<span class="cl" data-line="4">    <span class="text-[#c586c0]">if</span> (!response.<span class="text-[#9cdcfe]">ok</span>) <span class="text-[#c586c0]">throw new</span> <span class="text-[#4ec9b0]">Error</span>(<span class="text-[#ce9178]">`HTTP ${response.status}`</span>);</span>
<span class="cl" data-line="3">    <span class="text-[#569cd6]">const</span> resp_obj = <span class="text-[#569cd6]">await</span> response.<span class="text-[#dcdcaa]">json</span>();</span>
<span class="cl" data-line="6">    <span class="text-[#dcdcaa]">renderProducts</span>(resp_obj.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">products</span>);</span>
<span class="cl" data-line="5">  } <span class="text-[#c586c0]">catch</span> (error) {</span>
<span class="cl" data-line="5">    <span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">error</span>(<span class="text-[#ce9178]">'Load failed:'</span>, error);</span>
<span class="cl" data-line="5">    <span class="text-[#4ec9b0]">document</span>.<span class="text-[#dcdcaa]">getElementById</span>(<span class="text-[#ce9178]">'products'</span>).<span class="text-[#9cdcfe]">innerHTML</span> =</span>
<span class="cl" data-line="5">      <span class="text-[#ce9178]">`&lt;p class="error"&gt;Error loading&lt;/p&gt;`</span>;</span>
<span class="cl" data-line="5">  }</span>
<span class="cl" data-line="0">}</span></code></pre>

      <script type="application/json" data-cbuild-steps>
      [
        {"note":"ნაბიჯი 0 — ცარიელი async ფუნქცია. სიტყვა async ერთადერთ რამეს აკეთებს: აძლევს უფლებას შიგნით await დაწერო."},
        {"note":"ვაგზავნით მოთხოვნას. await ნიშნავს „აქ დაელოდე პასუხს“. ამ დროს ბრაუზერი არ იყინება — სხვა კოდი მუშაობს."},
        {"note":"ვამატებთ header-ს. ამის გარეშე ეს კონკრეტული API 401-ს დააბრუნებდა — მოთხოვნა მივიდოდა, მაგრამ უარით დაბრუნდებოდა."},
        {"note":"ტექსტს ობიექტად ვაქცევთ. .json() ისევ ლოდინია — სხეული შეიძლება ჯერ კიდევ მოდიოდეს, ამიტომ მასაც await სჭირდება."},
        {"note":"ყველაზე ხშირად გამოტოვებული ხაზი. fetch 404-ზე შეცდომას არ აგდებს — ჩვენ თვითონ უნდა შევამოწმოთ response.ok."},
        {"note":"try/catch. ქსელი წყდება, ტელეფონი გვირაბში შედის. მომხმარებელს ცარიელი ეკრანი კი არა, ტექსტი უნდა დახვდეს."},
        {"note":"და ბოლოს — მონაცემები ეკრანზე. მთელი ეს ფუნქცია ერთი წინადადებაა: სთხოვე, შეამოწმე, გადათარგმნე, აჩვენე."}
      ]
      </script>
    </div>
  </div>
</section>

<!-- 12 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="ასინქრონულობა" data-notes="დააჭირე ღილაკს და დარბაზს ხმამაღლა ათქმევინე, რა თანმიმდევრობით გამოჩნდება ხაზები. თითქმის ყოველთვის შეცდებიან. სწორედ ეს არის ასინქრონულობა: კოდი არ ჩერდება — ის აგრძელებს და პასუხს მაშინ ამუშავებს, როცა მოვა. ყავის ანალოგია დაუბრუნე ორჯერ.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12" id="asyncLab">
    <div class="col-span-5 flex flex-col">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ასინქრონულობა</p>
      <h2 class="display mt-3 text-5xl leading-[1] font-semibold">ჯერ დაპირება,<br>ყავა მერე</h2>

      <p class="mt-6 leading-relaxed text-ink-2">
        კაფეში შეკვეთისას ყავას მაშინვე არ გაძლევენ — გაძლევენ <b class="text-ink">დაპირებას</b>.
        დაპირებას ყავა არ არის, მაგრამ მოგვიანებით იქნება. და სანამ ელოდები,
        არავინ კეტავს კაფეს - სხვები აგრძელებენ შეკვეთას.
      </p>

      <div class="mt-6 grid gap-px bg-rule">
        <div class="bg-panel p-4"><p class="font-mono text-[12px] text-live">Promise</p><p class="mt-1 text-sm text-ink-2">ჩეკი. ობიექტი, რომელიც ამბობს „შედეგი მოგვიანებით იქნება“.</p></div>
        <div class="bg-panel p-4"><p class="font-mono text-[12px] text-live">await</p><p class="mt-1 text-sm text-ink-2">„ვდგები დახლთან, სანამ არ მომიტანენ“ </p></div>
        <div class="bg-panel p-4"><p class="font-mono text-[12px] text-live">async</p><p class="mt-1 text-sm text-ink-2">ფუნქციის ნიშანი, რომ მასში ლოდინი შეიძლება.</p></div>
      </div>

      <button id="asyncRun" class="mt-6 w-fit border border-ink bg-ink px-5 py-2.5 font-mono text-[13px] uppercase tracking-[0.15em] text-paper transition-colors hover:bg-live">▶ გაუშვი</button>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-5">
      <div class="grid grid-cols-2 gap-px bg-rule">
        <div class="bg-panel">
          <p class="border-b border-rule px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">კოდი</p>
          <pre class="overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.9] text-[#d4d4d4]"><code><span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">log</span>(<span class="text-[#ce9178]">'1 — შევუკვეთე'</span>);

<span class="text-[#dcdcaa]">fetch</span>(url).<span class="text-[#dcdcaa]">then</span>(() =&gt; {
  <span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">log</span>(<span class="text-[#ce9178]">'3 — ყავა მოვიდა'</span>);
});

<span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">log</span>(<span class="text-[#ce9178]">'2 — დავჯექი მაგიდასთან'</span>);</code></pre>
        </div>
        <div class="flex flex-col bg-panel">
          <p class="border-b border-rule px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">console</p>
          <div id="asyncOut" class="min-h-[12rem] flex-1 space-y-1.5 bg-[#1e1e1e] p-5 font-mono text-[13px] text-[#d4d4d4]"></div>
        </div>
      </div>

      <div class="border border-ink bg-ink p-6 text-paper">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-paper/60">რატომ არის ეს მნიშვნელოვანი</p>
        <p class="mt-3 text-lg leading-relaxed">
          თუ <code class="font-mono">fetch</code>-ის შემდეგ მაშინვე დაწერ <code class="font-mono">console.log(products)</code>-ს,
          <span class="text-[#f2a2a2]">undefined</span> დაგხვდება — არა იმიტომ, რომ კოდი მცდარია,
          არამედ იმიტომ, რომ <span class="text-[#8ad3a4]">ჯერ არ მოსულა</span>. მონაცემებთან მუშაობა
          მხოლოდ <code class="font-mono">await</code>-ის ან <code class="font-mono">.then()</code>-ის შიგნით შეიძლება.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 13 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="სინტაქსი" data-notes="ორივე კოდი ერთსა და იმავეს აკეთებს — ეს ხაზგასმით თქვი. .then() არ არის ძველი და მცდარი, ის უბრალოდ სხვა ჩაწერაა. მაგრამ როცა სამი მოთხოვნა ერთმანეთზეა დამოკიდებული, მარჯვენა სვეტი იკითხება, მარცხენა — არა. აჩვენე ბოლო ბლოკი და თქვი: ამას callback hell ერქვა.">
  <div class="flex h-full flex-col px-14 py-12">
    <div class="flex items-end justify-between border-b border-rule pb-4">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ორი სინტაქსი</p>
        <h2 class="display mt-3 text-5xl font-semibold"><code class="font-mono">.then()</code> და <code class="font-mono">await</code> — ერთი და იგივე</h2>
      </div>
      <p class="max-w-sm text-right text-sm text-ink-2">ორივე Promise-ს ელოდება. განსხვავება მხოლოდ იმაშია, თუ როგორ იკითხება ის, რაც შემდეგ ხდება.</p>
    </div>

    <div class="grid min-h-0 flex-1 grid-cols-2 gap-px bg-rule">
      <div class="flex min-h-0 flex-col bg-panel">
        <div class="flex items-center gap-2 border-b border-rule px-5 py-3">
          <span class="h-1.5 w-1.5 rounded-full bg-put"></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">.then() — ჯაჭვი</p>
        </div>
        <pre class="scroll min-h-0 flex-1 overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.9] text-[#d4d4d4]"><code><span class="text-[#dcdcaa]">fetch</span>(API_URL)
  .<span class="text-[#dcdcaa]">then</span>(response =&gt; response.<span class="text-[#dcdcaa]">json</span>())
  .<span class="text-[#dcdcaa]">then</span>(data =&gt; {
    <span class="text-[#dcdcaa]">renderProducts</span>(data.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">products</span>);
  })
  .<span class="text-[#dcdcaa]">catch</span>(error =&gt; {
    <span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">error</span>(error);
  });</code></pre>
        <div class="border-t border-rule p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">სამი მოთხოვნა ერთმანეთზე დამოკიდებული</p>
          <pre class="mt-3 overflow-auto bg-[#1e1e1e] p-4 font-mono text-[11.5px] leading-[1.7] text-[#d4d4d4]"><code><span class="text-[#dcdcaa]">getUser</span>().<span class="text-[#dcdcaa]">then</span>(u =&gt; {
  <span class="text-[#dcdcaa]">getOrders</span>(u.id).<span class="text-[#dcdcaa]">then</span>(o =&gt; {
    <span class="text-[#dcdcaa]">getItems</span>(o[<span class="text-[#b5cea8]">0</span>].id).<span class="text-[#dcdcaa]">then</span>(i =&gt; {
      <span class="italic text-[#6a9955]">// და ასე შემდეგ, მარჯვნივ და მარჯვნივ…</span>
    });
  });
});</code></pre>
        </div>
      </div>

      <div class="flex min-h-0 flex-col bg-panel">
        <div class="flex items-center gap-2 border-b border-rule px-5 py-3">
          <span class="h-1.5 w-1.5 rounded-full bg-get"></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">async / await — ზემოდან ქვემოთ</p>
        </div>
        <pre class="scroll min-h-0 flex-1 overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.9] text-[#d4d4d4]"><code><span class="text-[#c586c0]">try</span> {
  <span class="text-[#569cd6]">const</span> response = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(API_URL);
  <span class="text-[#569cd6]">const</span> data = <span class="text-[#569cd6]">await</span> response.<span class="text-[#dcdcaa]">json</span>();

  <span class="text-[#dcdcaa]">renderProducts</span>(data.<span class="text-[#9cdcfe]">data</span>.<span class="text-[#9cdcfe]">products</span>);
} <span class="text-[#c586c0]">catch</span> (error) {
  <span class="text-[#4ec9b0]">console</span>.<span class="text-[#dcdcaa]">error</span>(error);
}</code></pre>
        <div class="border-t border-rule p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">იგივე სამი მოთხოვნა</p>
          <pre class="mt-3 overflow-auto bg-[#1e1e1e] p-4 font-mono text-[11.5px] leading-[1.7] text-[#d4d4d4]"><code><span class="text-[#569cd6]">const</span> user   = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">getUser</span>();
<span class="text-[#569cd6]">const</span> orders = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">getOrders</span>(user.id);
<span class="text-[#569cd6]">const</span> items  = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">getItems</span>(orders[<span class="text-[#b5cea8]">0</span>].id);
<span class="italic text-[#6a9955]">// სამი ხაზი. სამივე იკითხება.</span></code></pre>
          <p class="mt-4 text-sm text-ink-2">ჩვენს <b class="text-ink">await</b> გვაქვს. სხვას კოდი კი შეიძლება <code class="font-mono text-[12px]">.then()</code>-ით ეწეროს — ორივე წაკითხვა უნდა შეგეძლოს.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 14 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="მახე" data-notes="აქ გააჩერე ლექცია. დაუსვი კითხვა, დაელოდე პასუხს, დაითვალე ხმები — და მხოლოდ მერე დააკლიკე ბარათს. ეს ერთი წუთი ყველაზე ღირებულია მთელ ლექციაში: fetch მხოლოდ მაშინ აგდებს შეცდომას, როცა სერვერამდე ვერ მიაღწია. 404 და 500 მისთვის წარმატებული პასუხებია.">
  <div class="flex h-full flex-col px-14 py-12">
    <div class="flex flex-1 flex-col justify-center">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-del"><span class="h-1.5 w-1.5 rounded-full bg-del"></span>მახე #1</p>
      <h2 class="display mt-3 text-5xl font-semibold">სერვერმა 404 დააბრუნა. სად მოხვდება კოდი?</h2>

      <div class="mt-8 flip-card cursor-pointer select-none" data-flip tabindex="0" role="button" aria-label="დააკლიკე პასუხის სანახავად">
        <div class="flip-inner">
          <div class="flip-front border border-rule bg-panel p-8 transition-colors hover:border-ink">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">იფიქრეთ, მერე დააკლიკეთ</p>
            <pre class="mt-4 overflow-auto bg-[#1e1e1e] p-5 font-mono text-[13.5px] leading-[1.9] text-[#d4d4d4]"><code><span class="text-[#c586c0]">try</span> {
  <span class="text-[#569cd6]">const</span> response = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(<span class="text-[#ce9178]">'/api/products/9999'</span>);  <span class="italic text-[#6a9955]">// ← არ არსებობს</span>
  <span class="text-[#569cd6]">const</span> data = <span class="text-[#569cd6]">await</span> response.<span class="text-[#dcdcaa]">json</span>();
  <span class="text-[#dcdcaa]">render</span>(data);          <span class="italic text-[#6a9955]">// A</span>
} <span class="text-[#c586c0]">catch</span> (error) {
  <span class="text-[#dcdcaa]">showError</span>();           <span class="italic text-[#6a9955]">// B</span>
}</code></pre>
            <p class="mt-5 text-lg">A თუ B?</p>
          </div>
          <div class="flip-back border border-ink bg-ink p-8 text-paper">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-paper/50">პასუხი</p>
            <p class="mt-2 display text-4xl font-semibold">A — <span class="text-[#f2a2a2]">render()</span> გაეშვება</p>
            <p class="mt-4 text-lg leading-relaxed">
              <code class="font-mono">fetch</code> შეცდომას აგდებს <b>მხოლოდ</b> მაშინ, როცა მოთხოვნა საერთოდ ვერ გაიგზავნა:
              ინტერნეტი არ არის, დომენი არ არსებობს, CORS-მა დაბლოკა.
            </p>
            <p class="mt-3 text-lg leading-relaxed">
              404 და 500 <span class="text-[#8ad3a4]">წარმატებით მიღებული პასუხებია</span> — მოთხოვნა მივიდა, სერვერმა უპასუხა.
              ის, რომ პასუხი არგამოგვადგება, HTTP-ის დონეზე პრობლემა არ არის.
            </p>
            <div class="mt-5 border-t border-paper/20 pt-4">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-paper/50">ამიტომ ვწერთ ამ ორ ხაზს ყოველთვის</p>
              <pre class="mt-2 font-mono text-[13px] leading-[1.8] text-[#8ad3a4]"><code><span class="text-[#c586c0]">if</span> (!response.ok) throw new Error(response.status);</code></pre>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-3 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-get">response.ok</p>
          <p class="mt-2 text-sm text-ink-2"><code class="font-mono">true</code>, თუ სტატუსი 200–299-შია. სხვა ყველაფერზე <code class="font-mono">false</code>.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-put">response.status</p>
          <p class="mt-2 text-sm text-ink-2">თავად რიცხვი — 200, 404, 500. შეცდომის ტექსტში ჩასმა აუცილებელია.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-del">catch</p>
          <p class="mt-2 text-sm text-ink-2">იჭერს ორივეს: ქსელის ავარიასაც და ჩვენ მიერ ხელით გადაგდებულ <code class="font-mono">Error</code>-საც.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 15 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="შეცდომები" data-notes="აქ UX-ზეა საუბარი და არა სინტაქსზე. კითხვა დარბაზს: რას ხედავს მომხმარებელი, სანამ მონაცემები მოდის? თუ პასუხია „არაფერს“, ეს ბაგია. აჩვენე dashboard.js-ის showStatus — სამი მდგომარეობა უკვე გვაქვს, უბრალოდ სახელი უნდა დავარქვათ.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>მდგომარეობები</p>
      <h2 class="display mt-4 text-5xl leading-[1] font-semibold">ყოველ<br>მოთხოვნას<br>ოთხი სახე აქვს</h2>
      <p class="mt-6 leading-relaxed text-ink-2">
        დამწყები კოდი მხოლოდ ერთს ხატავს — წარმატებულს. დანარჩენ სამში მომხმარებელი
        ცარიელ ეკრანს უყურებს და ფიქრობს, რომ აპლიკაცია გატყდა.
      </p>
      <div class="mt-8 border-l-2 border-live pl-5">
        <p class="text-lg leading-snug">ცხოვრებაში: <span class="text-ink-2">ლიფტის ღილაკი, რომელიც არ ინთება. დააჭირე კიდევ. და კიდევ. და კიდევ.</span></p>
      </div>
      <div class="mt-8 border border-rule bg-panel p-5 text-sm text-ink-2">
        <b class="text-ink">წესი:</b> სანამ <code class="font-mono text-[12px]">fetch</code>-ს დაწერ, ჯერ დაწერე ის, რაც ეკრანზე იქნება
        მოთხოვნის დროს. ერთი ხაზი <code class="font-mono text-[12px]">showStatus('იტვირთება…')</code> უფრო მეტს
        აკეთებს, ვიდრე ნებისმიერი ანიმაცია.
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-4">
      <div class="grid grid-cols-4 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">loading</p>
          <div class="mt-3 space-y-2"><div class="h-2 w-full animate-pulse rounded bg-rule"></div><div class="h-2 w-3/4 animate-pulse rounded bg-rule"></div></div>
          <p class="mt-3 text-sm">„იტვირთება…“</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-get">success</p>
          <div class="mt-3 space-y-2"><div class="h-2 w-full rounded bg-get/50"></div><div class="h-2 w-3/4 rounded bg-get/30"></div></div>
          <p class="mt-3 text-sm">მონაცემები</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-put">empty</p>
          <div class="mt-3 h-6 border border-dashed border-rule"></div>
          <p class="mt-3 text-sm">„ჯერ არაფერია. დაამატე პირველი.“</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-del">error</p>
          <div class="mt-3 h-6 border border-del/40 bg-del/10"></div>
          <p class="mt-3 text-sm">„ვერ ჩაიტვირთა. სცადე თავიდან.“</p>
        </div>
      </div>

      <div class="flex flex-col bg-panel">
        <div class="flex items-center gap-2 border-b border-[#2d2d2d] bg-[#252526] px-5 py-2.5">
          <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-[#969696]">dashboard.js</p>
        </div>
        <pre class="scroll overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.85] text-[#d4d4d4]"><code><span class="text-[#569cd6]">async function</span> <span class="text-[#dcdcaa]">getCars</span>() {
  <span class="text-[#dcdcaa]">showStatus</span>(<span class="text-[#ce9178]">'იტვირთება…'</span>, <span class="text-[#ce9178]">'loading'</span>);        <span class="italic text-[#6a9955]">// 1 — მაშინვე</span>
  <span class="text-[#c586c0]">try</span> {
    <span class="text-[#569cd6]">const</span> response = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(API_URL);
    <span class="text-[#c586c0]">if</span> (!response.<span class="text-[#9cdcfe]">ok</span>) <span class="text-[#c586c0]">throw new</span> <span class="text-[#4ec9b0]">Error</span>(response.<span class="text-[#9cdcfe]">status</span>);

    <span class="text-[#569cd6]">const</span> cars = <span class="text-[#569cd6]">await</span> response.<span class="text-[#dcdcaa]">json</span>();
    <span class="text-[#c586c0]">if</span> (cars.<span class="text-[#9cdcfe]">length</span> === <span class="text-[#b5cea8]">0</span>) <span class="text-[#c586c0]">return</span> <span class="text-[#dcdcaa]">showStatus</span>(<span class="text-[#ce9178]">'ჯერ არაფერია'</span>, <span class="text-[#ce9178]">'empty'</span>);  <span class="italic text-[#6a9955]">// 3</span>

    <span class="text-[#dcdcaa]">renderCars</span>(cars);                             <span class="italic text-[#6a9955]">// 2</span>
    <span class="text-[#dcdcaa]">hideStatus</span>();
  } <span class="text-[#c586c0]">catch</span> (error) {
    <span class="text-[#dcdcaa]">showStatus</span>(<span class="text-[#ce9178]">'ვერ ჩაიტვირთა. სცადე თავიდან.'</span>, <span class="text-[#ce9178]">'error'</span>);   <span class="italic text-[#6a9955]">// 4</span>
  }
}</code></pre>
      </div>

      <div class="border-l-2 border-del pl-5 text-ink-2">
        <b class="text-ink">console.error მომხმარებლისთვის არ არის.</b> ის შენთვისაა, მაგრამ საჭიროა მომხარებელსაც გავაგებინოთ სიტუაციის შესახებ.
      </div>
    </div>
  </div>
</section>

<!-- 16 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="რენდერი" data-notes="map → join → innerHTML არის ის სამი ნაბიჯი, რომელსაც ყველა ჩვენი ფუნქცია იმეორებს. ხაზი გაუსვი join('')-ს: მის გარეშე მასივი მძიმეებით გადაიქცევა ტექსტად და ეკრანზე მძიმეები გამოჩნდება. ბოლოს XSS-ზე ერთი წუთი — არ გააღრმავო, უბრალოდ თქვი, რომ პრობლემა არსებობს.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ეკრანზე</p>
      <h2 class="display mt-4 text-5xl leading-[1] font-semibold">მასივიდან<br>HTML-მდე</h2>

      <div class="mt-8 space-y-5">
        <div class="flex gap-4">
          <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 font-mono text-[12px] text-live">1</span>
          <div><p class="font-medium"><code class="font-mono">map()</code> — თითო ობიექტი, თითო სტრიქონი</p><p class="mt-1 text-sm text-ink-2">მასივი შიგნიდან არ იცვლება. map ახალ მასივს აბრუნებს.</p></div>
        </div>
        <div class="flex gap-4">
          <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 font-mono text-[12px] text-live">2</span>
          <div><p class="font-medium"><code class="font-mono">join('')</code> — სტრიქონების შეწებება</p><p class="mt-1 text-sm text-ink-2">ცარიელი ბრჭყალები აუცილებელია. <code class="font-mono text-[12px]">join()</code> ცარიელის გარეშე მძიმეებს ჩასვამს.</p></div>
        </div>
        <div class="flex gap-4">
          <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 font-mono text-[12px] text-live">3</span>
          <div><p class="font-medium"><code class="font-mono">innerHTML</code> — ერთხელ, ბოლოს</p><p class="mt-1 text-sm text-ink-2">ციკლში innerHTML-ის შეცვლა ბრაუზერს აიძულებს ყოველ ჯერზე თავიდან დახატოს.</p></div>
        </div>
      </div>

      <div class="mt-8 border border-del/40 bg-del/5 p-5">
        <p class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.15em] text-del">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M12 9v4"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 17h.01"/></svg>
          ბონუსი, რომელიც კურსში არ წერია
        </p>
        <p class="mt-2 text-sm">თუ <code class="font-mono text-[12px]">product.name</code> სერვერიდან მოდის და მასში <code class="font-mono text-[12px]">&lt;script&gt;</code> წერია, <code class="font-mono text-[12px]">innerHTML</code> მას <b>გაუშვებს</b>. ამას XSS ჰქვია. სასწავლო პროექტისთვის — ისწავლე, რომ არსებობს. რეალურისთვის — <code class="font-mono text-[12px]">textContent</code> ან escape.</p>
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-5">
      <div class="flex flex-col bg-panel">
        <div class="flex items-center gap-2 border-b border-[#2d2d2d] bg-[#252526] px-5 py-2.5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-[#969696]">app.js — renderProducts</p>
        </div>
        <pre class="scroll overflow-auto bg-[#1e1e1e] p-5 font-mono text-[13px] leading-[1.9] text-[#d4d4d4]"><code><span class="text-[#569cd6]">function</span> <span class="text-[#dcdcaa]">renderProducts</span>(products) {
  <span class="text-[#569cd6]">const</span> html = products.<span class="text-[#dcdcaa]">map</span>(product =&gt; <span class="text-[#ce9178]">`</span>
    <span class="text-[#ce9178]">&lt;div class="product"&gt;</span>
      <span class="text-[#ce9178]">&lt;img src="</span><span class="text-[#569cd6]">${</span>product.image<span class="text-[#569cd6]">}</span><span class="text-[#ce9178]">" alt="</span><span class="text-[#569cd6]">${</span>product.name<span class="text-[#569cd6]">}</span><span class="text-[#ce9178]">"&gt;</span>
      <span class="text-[#ce9178]">&lt;h3&gt;</span><span class="text-[#569cd6]">${</span>product.name<span class="text-[#569cd6]">}</span><span class="text-[#ce9178]">&lt;/h3&gt;</span>
      <span class="text-[#ce9178]">&lt;p&gt;</span><span class="text-[#569cd6]">${</span>product.price<span class="text-[#569cd6]">}</span><span class="text-[#ce9178]"> ₾&lt;/p&gt;</span>
    <span class="text-[#ce9178]">&lt;/div&gt;</span>
  <span class="text-[#ce9178]">`</span>).<span class="text-[#dcdcaa]">join</span>(<span class="text-[#ce9178]">''</span>);

  <span class="text-[#4ec9b0]">document</span>.<span class="text-[#dcdcaa]">getElementById</span>(<span class="text-[#ce9178]">'products'</span>).<span class="text-[#9cdcfe]">innerHTML</span> = html;
}</code></pre>
      </div>

      <div class="grid grid-cols-3 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">backtick <code>`</code></p>
          <p class="mt-2 text-sm text-ink-2">template literal — მრავალხაზოვანი ტექსტი, რომელშიც ცვლადი ჩაისმება.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">${ }</p>
          <p class="mt-2 text-sm text-ink-2">ჩასმის ადგილი. შიგნით ნებისმიერი გამოსახულება — მათ შორის <code class="font-mono text-[12px]">toLocaleString()</code>.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">data-id</p>
          <p class="mt-2 text-sm text-ink-2">ღილაკზე ჩაწერილი id — სწორედ ის, რაც შემდეგ სლაიდზე გამოგვადგება.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 17 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="ცოცხალი" data-notes="ეს ნამდვილი მოთხოვნაა ნამდვილ სერვერზე — გახსენი DevTools → Network და ერთად უყურეთ. თუ ინტერნეტი არ არის, სლაიდი თავად გადავა სადემონსტრაციო რეჟიმზე და ამას პატიოსნად დაწერს. აჩვენე დრო მილიწამებში: სწორედ ეს დროა ის, რის გამოც await გვჭირდება.">
  <div class="flex h-full flex-col px-14 py-12" id="liveLab">
    <div class="flex items-end justify-between border-b border-rule pb-4">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ცოცხალი დემო</p>
        <h2 class="display mt-3 text-5xl font-semibold">გავუშვათ ნამდვილი მოთხოვნა</h2>
      </div>
      <button id="liveSend" class="border border-ink bg-ink px-6 py-3 font-mono text-[13px] uppercase tracking-[0.15em] text-paper transition-colors hover:bg-live">▶ გაგზავნე</button>
    </div>

    <div class="mt-8 grid grid-cols-12 items-center gap-6">
      <div class="col-span-3 border border-rule bg-panel p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">კლიენტი</p>
        <p class="mt-2 font-medium">ეს სლაიდი</p>
        <p class="mt-1 font-mono text-[12px] text-ink-2">fetch(API_URL)</p>
      </div>

      <div class="col-span-6 relative h-24">
        <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-rule"></div>
        <div id="liveChip" class="absolute top-1/2 left-0 hidden -translate-y-1/2 border border-live bg-paper px-3 py-1.5 font-mono text-[12px] whitespace-nowrap text-live shadow"></div>
        <div id="liveHint" class="absolute inset-0 flex items-center justify-center font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">დააჭირე „გაგზავნე“-ს</div>
      </div>

      <div id="liveServer" class="col-span-3 border border-rule bg-panel p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">სერვერი</p>
        <p class="mt-2 font-medium">mockapi.io</p>
        <p class="mt-1 font-mono text-[12px] text-ink-2">/cars</p>
      </div>
    </div>

    <div class="mt-8 grid min-h-0 flex-1 grid-cols-12 gap-px bg-rule">
      <div class="col-span-4 flex flex-col bg-panel p-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">პასუხი</p>
        <div class="mt-4 flex items-baseline gap-3">
          <span id="liveStatus" class="display text-6xl font-semibold text-ink-2">—</span>
          <span id="liveStatusText" class="font-mono text-[13px] uppercase tracking-[0.15em] text-ink-2"></span>
        </div>
        <dl class="mt-6 space-y-3 border-t border-rule pt-5 font-mono text-[12px]">
          <div class="flex justify-between"><dt class="text-ink-2">დრო</dt><dd id="liveTime">—</dd></div>

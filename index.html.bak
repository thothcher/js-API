<!doctype html>
<html lang="ka" class="scroll-smooth">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>API — ლექცია</title>
<meta name="description" content="ლექციის სლაიდები API-ზე: HTTP, fetch, async/await, CRUD. გახსენით DevTools → Network." />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231e33e0' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M3 8h14l-4-4'/%3E%3Cpath d='M21 16H7l4 4'/%3E%3C/svg%3E" />

<!-- Tailwind v4, პირდაპირ ბრაუზერში. build step-ის გარეშე, განზრახ:
     ეს ფაილი ერთი ცალკე დგას — გახსენი ორმაგი დაწკაპუნებით, სერვერი არ სჭირდება. -->
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;500;600;700&family=Noto+Serif+Georgian:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style type="text/tailwindcss">
  @theme {
    --color-paper:   #e7eae9;
    --color-panel:   #f3f5f4;
    --color-ink:     #14171a;
    --color-ink-2:   #4a5157;
    --color-rule:    #c3cac9;
    --color-live:    #1e33e0;
    /* HTTP მეთოდების ფერები — იგივე კოდი, რასაც Postman/Swagger იყენებს:
       ფერი მეთოდის მნიშვნელობას ატარებს, არა დეკორაციას. */
    --color-get:     #2e7d4f;
    --color-post:    #1f6fb2;
    --color-put:     #b4741f;
    --color-del:     #b3352c;
    --font-display:  "Noto Serif Georgian", Georgia, serif;
    --font-sans:     "Noto Sans Georgian", ui-sans-serif, system-ui, sans-serif;
    --font-mono:     "IBM Plex Mono", "Noto Sans Georgian", ui-monospace, monospace;
  }
</style>

<style>
  /* ერთადერთი ხელით დაწერილი CSS ამ ფაილში — თითოეული წესი აქ იმიტომაა, რომ ბევრ უცნობ ელემენტს ეხება. */
  html, body { height: 100%; }
  body {
    background: #e7eae9; color: #14171a;
    font-family: "Noto Sans Georgian", system-ui, sans-serif;
    overflow: hidden;
  }
  .display { font-family: "Noto Serif Georgian", Georgia, serif; letter-spacing: -0.02em; }
  .grid-paper {
    background-image: radial-gradient(#14171a12 1px, transparent 1px);
    background-size: 16px 16px;
  }
  pre::-webkit-scrollbar, .scroll::-webkit-scrollbar { width: 8px; height: 8px; }
  pre::-webkit-scrollbar-thumb, .scroll::-webkit-scrollbar-thumb { background: #c3cac9; border-radius: 8px; }
  .slide { display: none; }
  .slide.is-active { display: block; overflow: auto; animation: rise .18s ease-out both; }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .slide.is-active { animation: none; } }

  /* flip-card: დარბაზი ჯერ პასუხობს, დაწკაპუნება ხსნის სწორ პასუხს */
  .flip-card { perspective: 1400px; overflow: hidden; }
  .flip-inner { display: grid; transition: transform .6s cubic-bezier(.4,.2,.2,1); transform-style: preserve-3d; }
  .flip-front, .flip-back { grid-area: 1 / 1; backface-visibility: hidden; }
  .flip-back { transform: rotateX(180deg); }
  .flip-card.is-flipped .flip-inner { transform: rotateX(180deg); }
  @media (prefers-reduced-motion: reduce) { .flip-inner { transition: none; } }

  /* x-ray inspector */
  body.xray [class]:hover { outline: 1px solid #1e33e0; outline-offset: 2px; cursor: crosshair; }

  mark { background: #1e33e01f; color: inherit; padding: 0 .15em; border-radius: 2px; }

  /* პროგრესული კოდის ჩვენება: თითო ხაზი ჩნდება თავის ნაბიჯზე */
  .cl { display: block; transition: background-color .25s ease; border-left: 2px solid transparent; padding-left: 10px; margin-left: -12px; }
  .cl[hidden] { display: none; }
  .cl.is-new { background: #1e33e026; border-left-color: #6f86ff; }

  /* მოთხოვნა → პასუხი ანიმაცია */
  @keyframes flyRight { from { transform: translateX(0); opacity: 0 } 15% { opacity: 1 } to { transform: translateX(var(--fly, 220px)); opacity: 1 } }
  @keyframes flyLeft  { from { transform: translateX(var(--fly, 220px)); opacity: 0 } 15% { opacity: 1 } to { transform: translateX(0); opacity: 1 } }
  .fly-req { animation: flyRight 1s cubic-bezier(.4,.1,.2,1) both; }
  .fly-res { animation: flyLeft  1s cubic-bezier(.4,.1,.2,1) both; }
  @media (prefers-reduced-motion: reduce) { .fly-req, .fly-res { animation: none; } }
  @keyframes pulseRing { 0% { box-shadow: 0 0 0 0 #1e33e055 } 70% { box-shadow: 0 0 0 14px #1e33e000 } 100% { box-shadow: 0 0 0 0 #1e33e000 } }
  .thinking { animation: pulseRing 1.1s ease-out infinite; }

  /* ლოგის ხაზები ასინქრონულ დემოში */
  @keyframes logIn { from { opacity: 0; transform: translateY(-4px) } to { opacity: 1; transform: none } }
  .log-line { animation: logIn .2s ease-out both; }

  /* ინტერაქციული ლაბორატორიების ღილაკები — ერთი და იგივე წესი ბევრ ელემენტზე,
     ამიტომ უტილიტების ნაცვლად კლასი. */
  .url-btn, .c-btn, .m-btn {
    border: 1px solid #c3cac9; background: #f3f5f4; cursor: pointer;
    font-family: "IBM Plex Mono", monospace; transition: border-color .15s, background-color .15s, color .15s;
  }
  .url-btn { padding: 7px 13px; font-size: 12px; }
  .url-btn:hover, .c-btn:hover, .m-btn:hover { border-color: #14171a; }
  .url-btn.is-on { background: #14171a; color: #e7eae9; border-color: #14171a; }

  .c-btn { padding: 13px 0; font-size: 15px; text-align: center; }
  .c-btn.is-on { background: #14171a; color: #e7eae9; border-color: #14171a; }

  .m-btn { display: flex; align-items: center; gap: 14px; padding: 13px 16px; text-align: left; font-family: inherit; font-size: 15px; }
  .m-btn.is-on { border-width: 2px; background: #e7eae9; font-weight: 600; }
  .m-tag { width: 5rem; flex-shrink: 0; font-family: "IBM Plex Mono", monospace; font-size: 12px; letter-spacing: .12em; }

  .j-btn { border: 0; border-bottom: 2px solid #c3cac9; background: none; padding: 0 6px; cursor: pointer; font-family: inherit; font-size: inherit; color: inherit; transition: color .15s, border-color .15s; }
  .j-btn.is-on { border-bottom-color: #1e33e0; color: #1e33e0; }
  .j-line { display: block; opacity: .3; transition: opacity .25s, background-color .25s; }
  .j-line.is-on { opacity: 1; background: #1e33e01f; }
</style>
</head>

<body class="grid-paper antialiased text-ink selection:bg-live/30 selection:text-ink">

<div class="fixed inset-x-0 top-0 z-50 h-[3px] bg-rule/40">
  <div id="bar" class="h-full w-0 bg-ink transition-[width] duration-300 ease-out"></div>
</div>

<main id="deck" class="h-screen w-screen pt-[3px] pb-11">

<!-- 01 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="სათაური" data-notes="დაიწყე ერთი კითხვით: დღეს რამდენჯერ ისარგებლეთ API-ით? პასუხი: ყოველ ჯერზე, როცა ამინდი ნახეთ, ტაქსი გამოიძახეთ ან გადარიცხვა გააკეთეთ. აწიონ ხელი ვინც ფიქრობს, რომ არასდროს — და მერე დაუთვალე.">
  <div class="flex h-full flex-col px-14 py-12">
    <div class="flex items-start justify-between font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">
      <span>ლექცია · frontend</span>
      <span>დასაწყებად დააჭირეთ <kbd class="border border-rule bg-panel px-1.5 py-0.5">→</kbd></span>
    </div>

    <div class="flex flex-1 flex-col justify-center">
      <div class="flex items-center gap-x-[3vw]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[7vw] w-auto shrink-0 text-live" aria-hidden="true">
          <path d="M3 8h14l-4-4"/><path d="M21 16H7l4 4"/>
        </svg>
        <h1 class="display text-[9vw] leading-[0.9] font-semibold">API</h1>
      </div>
      <p class="display mt-8 text-[2.6vw] leading-tight text-ink-2">როგორ ელაპარაკება<br>ერთი პროგრამა მეორეს</p>
      <div class="mt-8 h-px w-32 bg-live/40"></div>
      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-mono text-[12px] uppercase tracking-[0.15em]">
        <span class="text-get">get</span>
        <span class="text-post">post</span>
        <span class="text-put">put / patch</span>
        <span class="text-del">delete</span>
      </div>
    </div>
  </div>
</section>

<!-- 02 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="გეგმა" data-notes="60 წამი, არა მეტი. მთავარია თქვა: ლექციის ნახევარი ცოცხალია — DevTools → Network გახსნილი უნდა ჰქონდეთ მთელი დროის განმავლობაში. ბოლოს 5 დავალებაა.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5 flex flex-col justify-between">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>გეგმა</p>
        <h2 class="display mt-4 text-6xl leading-[1] font-semibold">რაზე<br>ვისაუბრებთ?</h2>
      </div>
      <div class="border-l-2 border-live pl-5 text-ink-2">
        <p>ერთი წინადადება, რომელსაც მთელი ლექცია ემსახურება:</p>
        <p class="mt-2 text-lg leading-snug text-ink">API არის <mark>შეთანხმება</mark> — მისამართების სია და წესები, თუ როგორ ითხოვ ინფორმაციის გაგზავნა-მოტანას.</p>
      </div>
    </div>

    <ol class="col-span-7 grid content-center gap-px bg-rule">
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">01</span><span>რა არის API და რატომ არ არის ეს ბიბლიოთეკა</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">02</span><span>HTTP მოთხოვნის ანატომია: მეთოდი, URL, header, body</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">03</span><span>GET · POST · PUT · PATCH · DELETE — და სტატუს კოდები</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">04</span><span><code class="font-mono text-[13px]">fetch()</code>, Promise, <code class="font-mono text-[13px]">async / await</code> — ინტერაქციულად</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">05</span><span>შეცდომების დამუშავება და ის ერთი მახე, რომელშიც ყველა ვვარდებით</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">06</span><span>სრული CRUD dashboard — ჩვენივე <code class="font-mono text-[13px]">dashboard.js</code>-ის მიხედვით</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">07</span><span>API key, CORS, უსაფრთხოება — რა ჩანს ბრაუზერში</span></li>
      <li class="flex items-center gap-6 bg-paper p-4"><span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded border border-live/30 bg-live/10 font-mono text-[11px] text-live">08</span><span>5 დავალება რეალური სცენარებით</span></li>
    </ol>
  </div>
</section>

<!-- 03 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="ანალოგია" data-notes="ეს არის ლექციის მთავარი სურათი — დაუბრუნდი მას ყოველ რთულ ადგილას. იკითხე დარბაზს: მიმტანი ამზადებს საჭმელს? არა. იცის რეცეპტი? არა. მაშინ რას აკეთებს? გადააქვს შეკვეთა და მოაქვს შედეგი. ზუსტად ესაა API. ხაზი გაუსვი: ჩვენი პროექტის API ნამდვილად რესტორნისაა.">
  <div class="flex h-full flex-col px-14 py-10">
    <div class="flex items-end justify-between border-b border-rule pb-4">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>რეალური ცხოვრება</p>
        <h2 class="display mt-3 text-5xl font-semibold">მიმტანი არის API</h2>
      </div>
      <p class="max-w-md text-right text-sm text-ink-2">შენ სამზარეულოში არ შედიხარ. არც გჭირდება. შენ იცი მხოლოდ ის, რაც მენიუშია დაწერილი.</p>
    </div>

    <div class="grid min-h-0 flex-1 grid-cols-3 items-center gap-8 py-8">
      <div class="border border-rule bg-panel p-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">შენ · მაგიდასთან</p>
        <p class="display mt-3 text-3xl font-semibold">კლიენტი</p>
        <p class="mt-4 text-ink-2">ბრაუზერი, მობილური აპლიკაცია, ჩვენი <code class="font-mono text-[13px]">index.html</code>.</p>
        <p class="mt-4 border-t border-rule pt-4 text-sm">იცის: <span class="text-ink-2">რა უნდა.</span><br>არ იცის: <span class="text-ink-2">როგორ კეთდება.</span></p>
      </div>

      <div class="relative flex flex-col items-center">
        <svg viewBox="0 0 200 24" class="w-full text-live" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h180" stroke-dasharray="4 4"/><path d="m176 6 8 6-8 6"/></svg>
        <div class="my-4 w-full border-2 border-live bg-paper p-6 text-center">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-live">მიმტანი</p>
          <p class="display mt-2 text-3xl font-semibold">API</p>
          <p class="mt-3 text-sm text-ink-2">იღებს შეკვეთას გასაგები ფორმით, აბრუნებს შედეგს გასაგები ფორმით.</p>
          <p class="mt-3 border-t border-rule pt-3 font-mono text-[12px] text-ink">/api/products</p>
        </div>
        <svg viewBox="0 0 200 24" class="w-full rotate-180 text-ink-2" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 12h180" stroke-dasharray="4 4"/><path d="m176 6 8 6-8 6"/></svg>
      </div>

      <div class="border border-rule bg-panel p-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">სამზარეულო</p>
        <p class="display mt-3 text-3xl font-semibold">სერვერი + ბაზა</p>
        <p class="mt-4 text-ink-2">იქ არის რეცეპტები, პროდუქტები, ფასები — და შენ იქ ვერ შეხვალ.</p>
        <p class="mt-4 border-t border-rule pt-4 text-sm">იცის: <span class="text-ink-2">როგორ კეთდება.</span><br>არ იცის: <span class="text-ink-2">ვინ და რატომ ითხოვს.</span></p>
      </div>
    </div>

    <div class="grid grid-cols-4 gap-px border-t border-rule bg-rule">
      <div class="bg-paper p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">მენიუ</p><p class="mt-1 text-sm">დოკუმენტაცია — რის თხოვნა შეიძლება</p></div>
      <div class="bg-paper p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">შეკვეთა</p><p class="mt-1 text-sm">Request — მეთოდი + მისამართი</p></div>
      <div class="bg-paper p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">კერძი</p><p class="mt-1 text-sm">Response — JSON მონაცემები</p></div>
      <div class="bg-paper p-4"><p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">„ეს დღეს არ გვაქვს“</p><p class="mt-1 text-sm">შეცდომა — 404, 500</p></div>
    </div>
  </div>
</section>

<!-- 04 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="განმარტება" data-notes="აქ მთავარია ის, რაც API არ არის. ხშირი შეცდომა: ფიქრობენ, რომ API ბიბლიოთეკაა, რომელსაც აინსტალირებ. არა — ის სხვის კომპიუტერზე მუშაობს და შენ მხოლოდ მისამართებს იცნობ. აჩვენე მარჯვნივ სამი ნაბიჯი და თქვი: სამივეს შორის ინტერნეტია, ესე იგი დრო და შეცდომის შანსი.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>განმარტება</p>
      <h2 class="display mt-4 text-6xl leading-[1] font-semibold">რა არის API<br>რეალურად</h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-2">
        <b class="text-ink">A</b>pplication <b class="text-ink">P</b>rogramming <b class="text-ink">I</b>nterface.
        სამივე სიტყვა მნიშვნელოვანია, მაგრამ მთავარი მაინც ბოლოა: <span class="text-live">ინტერფეისი</span>.
      </p>
      <p class="mt-4 text-lg leading-relaxed">
        ინტერფეისი არის ის ზედაპირი, რომელსაც ეხები, როცა შიგნით ვერ იხედები.
        ავტომობილის საჭე ინტერფეისია — არ გჭირდება იცოდე, როგორ მუშაობს ძრავა.
      </p>
      <div class="mt-8 border border-rule bg-panel p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">API არ არის</p>
        <ul class="mt-3 space-y-1.5 text-[15px] text-ink-2">
          <li>— ბიბლიოთეკა, რომელსაც <code class="font-mono text-[13px]">npm install</code>-ით იღებ</li>
          <li>— ბაზა, რომელშიც პირდაპირ წერ</li>
          <li>— ფაილი შენს პროექტში</li>
        </ul>
        <p class="mt-3 border-t border-rule pt-3 text-[15px]">ის სხვა სერვერზე მუშაობს. შენ მხოლოდ <b>მისამართები</b> და <b>წესები</b> იცი.</p>
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-6">
      <div class="grid grid-cols-3 gap-px bg-rule">
        <div class="bg-panel p-6">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.1em] text-live"><span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 text-[10px]">1</span>request</p>
          <p class="mt-3 font-medium">კლიენტი აგზავნის მოთხოვნას</p>
          <p class="mt-2 text-sm text-ink-2">„მომეცი ყველა პროდუქტი“. მისამართი + მეთოდი + საიდენტიფიკაციო header-ები.</p>
        </div>
        <div class="bg-panel p-6">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.1em] text-live"><span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 text-[10px]">2</span>process</p>
          <p class="mt-3 font-medium">სერვერი ამოწმებს და ასრულებს</p>
          <p class="mt-2 text-sm text-ink-2">ვინ ხარ? გაქვს უფლება? არსებობს ეს რესურსი? მერე მიმართავს ბაზას.</p>
        </div>
        <div class="bg-panel p-6">
          <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.1em] text-live"><span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-live/30 bg-live/10 text-[10px]">3</span>response</p>
          <p class="mt-3 font-medium">პასუხი ბრუნდება ტექსტად</p>
          <p class="mt-2 text-sm text-ink-2">სტატუს კოდი + JSON. ბრაუზერს ობიექტი კი არ მოსდის, ტექსტი — რომელსაც ჩვენ ვშლით.</p>
        </div>
      </div>

      <div class="border border-ink bg-ink p-6 text-paper">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-paper/60">რაზეც ხშირად არავინ საუბრობს</p>
        <p class="mt-3 text-lg leading-relaxed">
          ამ სამ ნაბიჯს შორის <span class="text-[#8ad3a4]">დრო</span> დგას — 50 მილიწამი ან 4 წამი, ან საერთოდ უსასრულობა.
          სწორედ ამიტომ არის API-ს კოდი <span class="text-[#8ad3a4]">ასინქრონული</span>, და სწორედ ამიტომ
          სჭირდება ყოველ ფუნქციას პასუხი კითხვაზე: „და თუ არ მოვიდა?“
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 05 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="ანატომია" data-notes="შეანელე. როგორც კი მოთხოვნის ოთხ ნაწილს ერთმანეთისგან გაარჩევენ, ყველაფერი დანარჩენი ლექსიკონია. აჩვენე იგივე ოთხი ნაწილი DevTools → Network → Headers-ში ცოცხლად. ხაზი გაუსვი: GET-ს body არ აქვს — ეს ხშირი შეცდომაა.">
  <div class="flex h-full flex-col px-14 py-12">
    <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>ანატომია</p>
    <h2 class="display mt-3 text-5xl font-semibold">მოთხოვნის ოთხი ნაწილი</h2>

    <div class="mt-10 flex flex-wrap items-end gap-x-3 gap-y-2 font-mono text-[clamp(1rem,2.2vw,1.8rem)]">
      <span class="border-b-2 border-get px-2">POST</span>
      <span class="border-b-2 border-live px-2">https://api.example.ge/cars</span>
      <span class="border-b-2 border-put px-2">x-api-key: …</span>
      <span class="border-b-2 border-post px-2">{ "name": "Ferrari" }</span>
    </div>

    <div class="mt-8 grid grid-cols-4 gap-8 text-sm">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-get">მეთოდი · ზმნა</p>
        <p class="mt-2 text-ink-2">რა უნდა გააკეთო რესურსთან. წაიკითხო, დაამატო, შეცვალო თუ წაშალო.</p>
        <p class="mt-2 text-ink">ცხოვრებაში: <span class="text-ink-2">„მაჩვენე“ თუ „წაიღე“.</span></p>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-live">URL · მისამართი</p>
        <p class="mt-2 text-ink-2">რომელ რესურსზე. ერთი კონკრეტული თარო კონკრეტულ საწყობში.</p>
        <p class="mt-2 text-ink">ცხოვრებაში: <span class="text-ink-2">ქუჩა და სახლის ნომერი.</span></p>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-put">Headers · მეტამონაცემები</p>
        <p class="mt-2 text-ink-2">ვინ ვარ, რა ფორმატს ველოდები, რა ფორმატს ვგზავნი.</p>
        <p class="mt-2 text-ink">ცხოვრებაში: <span class="text-ink-2">კონვერტზე დაწერილი გამგზავნი.</span></p>
      </div>
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-post">Body · ტვირთი</p>
        <p class="mt-2 text-ink-2">თავად მონაცემები, რომელსაც აგზავნი. მხოლოდ POST / PUT / PATCH-ს აქვს.</p>
        <p class="mt-2 text-ink">ცხოვრებაში: <span class="text-ink-2">წერილი კონვერტის შიგნით.</span></p>
      </div>
    </div>

    <div class="mt-8 grid min-h-0 flex-1 grid-cols-2 gap-px bg-rule">
      <div class="flex min-h-0 flex-col bg-panel">
        <div class="border-b border-rule px-5 py-2.5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">როგორ გამოიყურება ის ქსელში</p>
        </div>
        <pre class="scroll min-h-0 flex-1 overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.8] text-[#d4d4d4]"><code><span class="text-[#c586c0]">POST</span> <span class="text-[#ce9178]">/cars</span> <span class="text-[#569cd6]">HTTP/1.1</span>
<span class="text-[#9cdcfe]">Host</span>: api.example.ge
<span class="text-[#9cdcfe]">Content-Type</span>: <span class="text-[#ce9178]">application/json</span>
<span class="text-[#9cdcfe]">x-api-key</span>: <span class="text-[#ce9178]">13e8bfec-03fb-…</span>

{<span class="text-[#9cdcfe]">"name"</span>: <span class="text-[#ce9178]">"Ferrari 250 GTO"</span>, <span class="text-[#9cdcfe]">"year"</span>: <span class="text-[#b5cea8]">1963</span>}</code></pre>
      </div>
      <div class="flex min-h-0 flex-col bg-panel">
        <div class="border-b border-rule px-5 py-2.5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">როგორ ვწერთ ჩვენ — იგივე ოთხი ნაწილი</p>
        </div>
        <pre class="scroll min-h-0 flex-1 overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.8] text-[#d4d4d4]"><code><span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(<span class="text-[#ce9178]">'https://api.example.ge/cars'</span>, {
  <span class="text-[#9cdcfe]">method</span>: <span class="text-[#ce9178]">'POST'</span>,
  <span class="text-[#9cdcfe]">headers</span>: { <span class="text-[#ce9178]">'Content-Type'</span>: <span class="text-[#ce9178]">'application/json'</span> },
  <span class="text-[#9cdcfe]">body</span>: <span class="text-[#4ec9b0]">JSON</span>.<span class="text-[#dcdcaa]">stringify</span>(car),
});</code></pre>
        <div class="border-t border-rule px-5 py-3 text-xs text-ink-2">
          პირველი არგუმენტი — მისამართი. მეორე — დანარჩენი სამივე ნაწილი, ერთ ობიექტში.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 06 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="URL" data-notes="ეს სლაიდი ინტერაქციულია — ჩართე და გამორთე ფილტრები და ერთად უყურეთ, როგორ იცვლება მისამართი და შედეგების რაოდენობა. მთავარი აზრი: query parameter არ ცვლის რესურსს, ის მხოლოდ ავიწროებს პასუხს. კითხვა დარბაზს: რომელი ნაწილი უნდა შეიცვალოს, თუ ერთი კონკრეტული პროდუქტი გვინდა?">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5 flex flex-col">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>მისამართი</p>
      <h2 class="display mt-3 text-5xl leading-[1] font-semibold">URL იკითხება<br>მარცხნიდან<br>მარჯვნივ</h2>

      <div class="mt-8 space-y-4 text-[15px]">
        <div class="flex gap-4"><span class="w-28 shrink-0 font-mono text-[12px] uppercase tracking-[0.12em] text-ink-2">protocol</span><span><code class="font-mono text-live">https://</code><span class="text-ink-2"> - <strong> Hypertext Transfer Protocol Secure.</strong></span> - დაშიფრული კავშირი. </span></div>
        <div class="flex gap-4"><span class="w-28 shrink-0 font-mono text-[12px] uppercase tracking-[0.12em] text-ink-2">host</span><span><code class="font-mono text-live">restaurantapi.stepacademy.ge</code> — <span class="text-ink-2">რომელი სერვერი.</span></span></div>
        <div class="flex gap-4"><span class="w-28 shrink-0 font-mono text-[12px] uppercase tracking-[0.12em] text-ink-2">path</span><span><code class="font-mono text-live">/api/products</code> — <span class="text-ink-2">რომელი რესურსი. მრავლობითი რიცხვი სტანდარტია.</span></span></div>
        <div class="flex gap-4"><span class="w-28 shrink-0 font-mono text-[12px] uppercase tracking-[0.12em] text-ink-2">query</span><span><code class="font-mono text-live">?category=pizza</code> — <span class="text-ink-2">ფილტრი, დახარისხება, გვერდი. იწყება <code class="font-mono">?</code>-ით, გრძელდება <code class="font-mono">&amp;</code>-ით.</span></span></div>
      </div>

      <div class="mt-auto border-l-2 border-live pl-5">
        <p class="text-lg leading-snug">ცხოვრებაში: <span class="text-ink-2">ბიბლიოთეკის თარო არის path. „მხოლოდ ქართული, მხოლოდ 2020-ის შემდეგ“ არის query.</span></p>
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-6" id="urlLab">
      <div class="border border-rule bg-panel p-6">
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-2">ჩართე ფილტრები და დააკვირდი მისამართს როგორ იცვლება</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button data-q="category=pizza" class="url-btn">category=pizza</button>
          <button data-q="minPrice=10" class="url-btn">minPrice=10</button>
          <button data-q="sort=price" class="url-btn">sort=price</button>
          <button data-q="limit=5" class="url-btn">limit=5</button>
          <button data-q="page=2" class="url-btn">page=2</button>
        </div>
      </div>

      <div class="border border-ink bg-ink p-6">
        <p class="mb-3 flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.15em] text-paper/40"><span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#8ad3a4]"></span>საბოლოო მისამართი</p>
        <p class="font-mono text-[15px] leading-relaxed break-all">
          <span class="text-paper/40">https://</span><span class="text-paper/70">restaurantapi.stepacademy.ge</span><span class="text-[#8ad3a4]">/api/products</span><span id="urlQuery" class="text-[#f0c674]"></span>
        </p>
      </div>

      <div class="grid grid-cols-2 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">დაბრუნებული ჩანაწერები</p>
          <p id="urlCount" class="display mt-2 text-4xl font-semibold">124</p>
          <p class="mt-1 text-sm text-ink-2">ერთი და იმავე რესურსიდან — უბრალოდ ნაკლები.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">იგივე კოდში</p>
          <p id="urlCode" class="mt-2 font-mono text-[12px] leading-relaxed break-all text-ink-2"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 07 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="მეთოდები" data-notes="დააჭირე თითოეულ მეთოდს და ხმამაღლა წაიკითხე ცხოვრებისეული მაგალითი — ეს რჩებათ ყველაზე კარგად. მთავარი კითხვა დარბაზს: რომელი მეთოდის ორჯერ გაშვება არის საშიში? პასუხი მხოლოდ POST-ია. აქედან გამომდინარეობს ყველა „ორმაგი გადახდის“ ბაგი მსოფლიოში.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12" id="methodLab">
    <div class="col-span-4 flex flex-col">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>CRUD</p>
      <h2 class="display mt-3 text-5xl leading-[1] font-semibold">ოთხი ზმნა,<br>რომელიც<br>ყველაფერს ფარავს</h2>

      <div class="mt-8 grid gap-2">
        <button data-m="GET"    class="m-btn"><span class="m-tag">GET</span><span>წამოიღე</span></button>
        <button data-m="POST"   class="m-btn"><span class="m-tag">POST</span><span>შექმენი</span></button>
        <button data-m="PUT"    class="m-btn"><span class="m-tag">PUT</span><span>შეცვალე</span></button>
        <button data-m="DELETE" class="m-btn"><span class="m-tag">DELETE</span><span>წაშალე</span></button>
      </div>

      <div class="mt-auto border border-rule bg-panel p-5 text-sm text-ink-2">
        ამ ოთხს ერთად შემოკლებით<b class="text-ink">CRUD</b> ჰქვია: Create, Read, Update, Delete.
      </div>
    </div>

    <div class="col-span-8 flex flex-col justify-center gap-5">
      <div id="mHead" class="border-2 p-6">
        <p id="mLabel" class="font-mono text-[11px] uppercase tracking-[0.18em]"></p>
        <p id="mTitle" class="display mt-2 text-4xl font-semibold"></p>
        <p id="mDesc" class="mt-3 text-lg leading-relaxed text-ink-2"></p>
      </div>

      <div class="grid grid-cols-2 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">ცხოვრებისეული მაგალითი</p>
          <p id="mReal" class="mt-2 leading-relaxed"></p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">თუ ორჯერ გაუშვებ?</p>
          <p id="mIdem" class="mt-2 leading-relaxed"></p>
        </div>
      </div>

      <pre class="scroll overflow-auto bg-[#1e1e1e] p-5 font-mono text-[12.5px] leading-[1.8] text-[#d4d4d4]"><code id="mCode"></code></pre>

      <div class="flex items-center justify-between border border-rule bg-panel px-5 py-3 font-mono text-[12px]">
        <span class="uppercase tracking-[0.15em] text-ink-2">წარმატების ტიპური სტატუსი</span>
        <span id="mStatus" class="border border-ink bg-ink px-3 py-1 text-paper"></span>
      </div>
    </div>
  </div>
</section>

<!-- 08 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="სტატუსები" data-notes="დააწკაპუნე კოდებზე. მთავარი წესი, რომელიც უნდა დაიმახსოვრონ: 4xx — შენ შეგეშალა, 5xx — სერვერს შეეშალა. და თუ სულ 0-ს ან „Failed to fetch“-ს ხედავ, საერთოდ ვერ მიაღწიე სერვერამდე — ეს ჩვეულებრივ CORS-ია ან ინტერნეტი.">
  <div class="flex h-full flex-col px-14 py-12">
    <div class="flex items-end justify-between">
      <div>
        <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>პასუხი</p>
        <h2 class="display mt-3 text-5xl font-semibold">სტატუს კოდი — სამნიშნა პასუხი</h2>
      </div>
      <p class="max-w-sm text-right text-sm text-ink-2">სერვერი ჯერ რიცხვით გპასუხობს და მხოლოდ მერე მონაცემებით. ეს რიცხვი პრაქტიკული დანიშნულებისაა.</p>
    </div>

    <div class="mt-8 grid grid-cols-5 gap-px bg-rule text-center font-mono text-[12px] uppercase tracking-[0.12em]">
      <div class="bg-panel p-3 text-ink-2">1xx · მიმდინარეობს</div>
      <div class="bg-panel p-3 text-get">2xx · გამოვიდა</div>
      <div class="bg-panel p-3 text-put">3xx · სხვაგან წადი</div>
      <div class="bg-panel p-3 text-del">4xx · შენ შეგეშალა</div>
      <div class="bg-panel p-3 text-del">5xx · სერვერს შეეშალა</div>
    </div>

    <div class="mt-8 grid min-h-0 flex-1 grid-cols-12 gap-8" id="codeLab">
      <div class="col-span-7 grid grid-cols-4 content-start gap-2">
        <button data-c="200" class="c-btn">200</button>
        <button data-c="201" class="c-btn">201</button>
        <button data-c="204" class="c-btn">204</button>
        <button data-c="304" class="c-btn">304</button>
        <button data-c="400" class="c-btn">400</button>
        <button data-c="401" class="c-btn">401</button>
        <button data-c="403" class="c-btn">403</button>
        <button data-c="404" class="c-btn">404</button>
        <button data-c="409" class="c-btn">409</button>
        <button data-c="422" class="c-btn">422</button>
        <button data-c="429" class="c-btn">429</button>
        <button data-c="500" class="c-btn">500</button>
        <button data-c="502" class="c-btn">502</button>
        <button data-c="503" class="c-btn">503</button>
        <button data-c="0" class="c-btn col-span-2">Failed to fetch</button>
      </div>

      <div class="col-span-5 flex flex-col gap-4">
        <div id="cHead" class="border-2 p-6">
          <p id="cNum" class="display text-6xl font-semibold"></p>
          <p id="cName" class="mt-1 font-mono text-[13px] uppercase tracking-[0.15em]"></p>
          <p id="cDesc" class="mt-4 leading-relaxed"></p>
        </div>
        <div class="border border-rule bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">რას აკეთებ, როცა ამას ხედავ</p>
          <p id="cFix" class="mt-2 text-[15px] leading-relaxed"></p>
        </div>
        <div class="border border-rule bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-ink-2">ცხოვრებაში</p>
          <p id="cReal" class="mt-2 text-[15px] leading-relaxed text-ink-2"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 09 ───────────────────────────────────────────────────────────── -->
<section class="slide h-full" data-section="Headers" data-notes="აჩვენე ჩვენივე app.js. აქ სამი კითხვაა დარბაზისთვის: 1) რა მოხდება, თუ header-ს არ გავგზავნით — 401. 2) ვინ ხედავს ამ გასაღებს ბრაუზერში — ყველა. 3) მაშინ რატომ ვწერთ? იმიტომ, რომ სასწავლო პროექტია — და ეს პატიოსნად უნდა ითქვას. უსაფრთხოების სლაიდზე დავუბრუნდებით.">
  <div class="grid h-full grid-cols-12 gap-10 px-14 py-12">
    <div class="col-span-5">
      <p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-live"><span class="h-1.5 w-1.5 rounded-full bg-live"></span>Headers</p>
      <h2 class="display mt-4 text-5xl leading-[1] font-semibold">კონვერტზე<br>დაწერილი<br>ინფორმაცია</h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-2">
        Header არ არის მონაცემი. ეს არის მონაცემის შესახებ ინფორმაცია — ვინ აგზავნის,
        რა ფორმატით, ვის აქვს უფლება.
      </p>

      <div class="mt-8 space-y-3">
        <div class="border border-rule bg-panel p-4">
          <p class="font-mono text-[13px] text-live">x-api-key</p>
          <p class="mt-1 text-sm text-ink-2">„ვინ ხარ“. ღონისძიების სამაჯური — თუ ხელზე არ გაქვს, კარს ვერ გაცდები.</p>
        </div>
        <div class="border border-rule bg-panel p-4">
          <p class="font-mono text-[13px] text-live">Content-Type: application/json</p>
          <p class="mt-1 text-sm text-ink-2">„რას გიგზავნი“. ამის გარეშე სერვერი შენს JSON-ს უბრალო ტექსტად ჩათვლის და 400-ს დაგიბრუნებს.</p>
        </div>
        <div class="border border-rule bg-panel p-4">
          <p class="font-mono text-[13px] text-live">Authorization: Bearer …</p>
          <p class="mt-1 text-sm text-ink-2">იგივე იდეა, სტანდარტული ფორმით — ტოკენი, რომელიც შესვლის შემდეგ მიიღე.</p>
        </div>
      </div>
    </div>

    <div class="col-span-7 flex flex-col justify-center gap-6">
      <div class="flex flex-col bg-panel">
        <div class="flex items-center gap-2 border-b border-[#2d2d2d] bg-[#252526] px-5 py-2.5">
          <span class="flex gap-1.5"><span class="h-2.5 w-2.5 rounded-full bg-[#ff5f56]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#ffbd2e]"></span><span class="h-2.5 w-2.5 rounded-full bg-[#27c93f]"></span></span>
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-[#969696]">app.js — ჩვენი ნამდვილი კოდი</p>
        </div>
        <pre class="scroll overflow-auto bg-[#1e1e1e] p-5 font-mono text-[13px] leading-[1.8] text-[#d4d4d4]"><code><span class="text-[#569cd6]">const</span> <span class="text-[#4fc1ff]">API_KEY</span> = <span class="text-[#ce9178]">'13e8bfec-03fb-42f6-9b95-6a148dda8a25'</span>;
<span class="text-[#569cd6]">const</span> <span class="text-[#4fc1ff]">API_URL</span> = <span class="text-[#ce9178]">'https://restaurantapi.stepacademy.ge/api/products'</span>;

<span class="text-[#569cd6]">const</span> response = <span class="text-[#569cd6]">await</span> <span class="text-[#dcdcaa]">fetch</span>(API_URL, {
  <span class="text-[#9cdcfe]">headers</span>: {
    <span class="text-[#ce9178]">'x-api-key'</span>: API_KEY   <span class="italic text-[#6a9955]">// ← ეს ერთი ხაზი ბევრს წყვეტს</span>
  },
});</code></pre>
      </div>

      <div class="grid grid-cols-2 gap-px bg-rule">
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-get">header-ით</p>
          <p class="mt-2 font-mono text-2xl text-get">200 OK</p>
          <p class="mt-2 text-sm text-ink-2">მონაცემები მოვიდა.</p>
        </div>
        <div class="bg-panel p-5">
          <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-del">header-ის გარეშე</p>
          <p class="mt-2 font-mono text-2xl text-del">401 Unauthorized</p>
          <p class="mt-2 text-sm text-ink-2">სერვერმა ვერ გიცნო. კოდი სწორია, გასაღები არა.</p>
        </div>
      </div>

      <div class="border-l-2 border-live pl-5 text-ink-2">
        დაიმახსოვრე: <span class="text-ink">headers</span> არის ობიექტი <code class="font-mono text-[13px]">fetch</code>-ის მეორე არგუმენტში.
        თუ მეორე არგუმენტს საერთოდ არ გადასცემ, მოთხოვნა ავტომატურად GET-ია header-ების გარეშე.
      </div>
    </div>
  </div>
</section>

